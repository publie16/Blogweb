<%- include("partials/header.ejs") %>
<body class="bg-wrapper">
    <form action="/filter" method="POST" style="margin: 1rem 0;">
  <label for="category">Filter by Category:</label>
  <select name="category" id="category" class="form-select w-auto d-inline" onchange="this.form.submit()">
    <option disabled selected value="">Select Category</option>
    <option value="social">Social</option>
    <option value="culture/history">Culture / History</option>
    <option value="science/technology">Science and Technology</option>
    <option value="innovative/interesting">Innovating and Interesting</option>
  </select>
</form>

<% if (posts && posts.length > 0) {
    posts.forEach(function(post) { %>
        <div class="col thumbnail"> 
            <div class="card shadow-lg"> 
                <div class="card-body"> 
                    <strong><%=post.title%></strong>
                    <p class="card-text"><%= post.desc %></p> 
                    <div class="d-flex justify-content-between align-items-center"> 
                        <div class="btn-group"> 
                            <a href="/viewpost/<%= post.id %>" class="btn btn-sm btn-outline-secondary">View</a>
                            <a href="/editpost/<%= post.id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <button class="btn btn-sm btn-outline-secondary delete-btn" data-id="<%= post.id %>">Delete</button>
                        </div> 
                        <small class="text-body-secondary"><%=post.time%></small> 
                    </div> 
                </div> 
            </div> 
        </div>
<% }); } else { %>
    <h1 style="text-align: center; padding-top: 17rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="50" fill="currentColor" class="bi bi-postage-heart" viewBox="0 0 16 16">
  <path d="M3.5 1a1 1 0 0 0 1-1h1a1 1 0 0 0 2 0h1a1 1 0 0 0 2 0h1a1 1 0 1 0 2 0H15v1a1 1 0 1 0 0 2v1a1 1 0 1 0 0 2v1a1 1 0 1 0 0 2v1a1 1 0 1 0 0 2v1a1 1 0 1 0 0 2v1h-1.5a1 1 0 1 0-2 0h-1a1 1 0 1 0-2 0h-1a1 1 0 1 0-2 0h-1a1 1 0 1 0-2 0H1v-1a1 1 0 1 0 0-2v-1a1 1 0 1 0 0-2V9a1 1 0 1 0 0-2V6a1 1 0 0 0 0-2V3a1 1 0 0 0 0-2V0h1.5a1 1 0 0 0 1 1M3 3v10a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1"/>
  <path d="M8 11C2.175 7.236 6.336 4.31 8 5.982 9.664 4.309 13.825 7.236 8 11"/>
</svg><br>
No posts yet</h1>
<% } %>
</body>
<script>
  document.querySelectorAll(".delete-btn").forEach(button => {
    button.addEventListener("click", () => {
      const id = button.dataset.id;
      if (confirm("Are you sure you want to delete this post?")) {
        fetch(`/deletepost/${id}`, {
          method: "DELETE"
        }).then(res => {
          if (res.ok) {
            window.location.reload(); // reload page after deletion
          } else {
            alert("Failed to delete post.");
          }
        });
      }
    });
  });
</script>
